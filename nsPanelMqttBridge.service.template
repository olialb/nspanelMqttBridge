[Unit]
Description=nsPanelMqttBridge
After=network.target

[Service]
Type=idle
Restart=on-failure
User=$USER
Environment=PYTHONPATH=/home/$USER/nsPanelMqttBridge
WorkingDirectory=/home/$USER/nsPanelMqttBridge
ExecStart=/home/$USER/nsPanelMqttBridge/venv/bin/python nspanel_mqtt_bridge.py

[Install]
WantedBy=multi-user.target
